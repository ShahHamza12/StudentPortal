{
    "name": "student-dashboard",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "concurrently \"npm run server:start\" \"vite\"",
        "client": "vite",
        "build": "vite build",
        "lint": "eslint .",
        "preview": "vite preview",
        "server": "npm --prefix server install && npm --prefix server run dev",
        "server:start": "npm --prefix server start",
        "all": "concurrently \"npm run server\" \"npm run dev\""
    },
    "dependencies": {
        "@tailwindcss/postcss": "^4.2.2",
        "autoprefixer": "^10.4.27",
        "lucide-react": "^1.11.0",
        "postcss": "^8.5.9",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "tailwindcss": "^4.2.2"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.1",
        "eslint": "^9.39.4",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.5.2",
        "globals": "^17.4.0",
        "vite": "^8.0.4",
        "concurrently": "^8.2.1"
    }
}
